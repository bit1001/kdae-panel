[Unit]
Description=kdae-panel Web Management Service
Documentation=https://github.com/tuoro/kdae-panel
After=network-online.target dae.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/kdae-panel/kdae-panel.env
# 一次性链接通过 root-only 的运行时文件交给安装脚本，避免解析 journald 文本。
RuntimeDirectory=kdae-panel
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/kdae-panel --setup-url-file=/run/kdae-panel/setup-url
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=15s
UMask=0077

# 面板需要管理 dae、写入配置并通过 systemd 控制服务；其余系统面尽量收紧。
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# 代价：dae 搜索 geo 的顺序里有 /root/.local/share/dae，ProtectHome 把 /root 换成
# 空目录后面板永远看不到那里。为一个少见的 geo 目录敞开整个 /root 不划算，
# 改为让界面如实说"面板看不到"而非断言"文件不存在"（见 internal/geodata/locate.go）。
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
# sysdump 需要读取 /proc/sys/net；ProtectProc 仍会隐藏其他进程。
ProcSubset=all
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_KILL CAP_NET_ADMIN
AmbientCapabilities=CAP_KILL CAP_NET_ADMIN
# 这些目录必须在服务启动前就存在：没有 "-" 前缀时，systemd 对不存在的路径
# 会直接放弃搭建挂载命名空间（226/NAMESPACE）。install.sh 负责建好它们，
# 手工部署本单元时也要先建。不加 "-" 前缀是有意的：加了虽能启动，
# 但 ProtectSystem=strict 下写入照样 EROFS，故障会推迟到运行时才暴露。
ReadWritePaths=/etc/dae /var/lib/kdae-panel /usr/bin /etc/systemd/system
# /usr/bin 与 /etc/systemd/system 让默认开启的 dae 版本管理可直接完成首次安装和
# 版本切换。前者在 root 的 PATH 上，后者能定义以 root 运行的服务；不需要该功能的
# 部署可关闭 KDAE_PANEL_ENABLE_DAE_INSTALL，并用 drop-in 收紧这些写路径。
# dae 若实际位于其他目录，仍需按 systemctl show dae --property=ExecStart 追加该目录。
# geo 数据写在配置目录（/etc/dae），已被上面覆盖，无需额外放宽。

[Install]
WantedBy=multi-user.target
